<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.quizmaster.model.DescriptiveEvaluation" %>
<%@ page import="java.util.List" %>
<%
    if (session.getAttribute("adminLoggedIn") == null) {
        response.sendRedirect("admin-login.jsp");
        return;
    }

    List<DescriptiveEvaluation> evaluations = (List<DescriptiveEvaluation>) request.getAttribute("evaluations");
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Descriptive Evaluation Review — QuizMaster Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css?v=2.0">
</head>
<body>

    <!-- Header Navbar -->
    <header class="qm-navbar">
        <a class="qm-navbar-brand" href="admin-dashboard">
            <i class="fa-solid fa-graduation-cap"></i> QuizMaster <span class="badge badge-primary ms-1">Admin</span>
        </a>
        <div class="qm-navbar-user">
            <span><i class="fa-solid fa-user-shield text-primary me-1"></i> <%= session.getAttribute("adminUsername") %></span>
            <a href="adminLogout" class="btn btn-outline-gray btn-sm text-danger"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Logout</a>
        </div>
    </header>

    <div class="page-wrapper">
        <div class="container" style="max-width: 1040px;">
            <div class="mb-3">
                <a href="admin-dashboard" class="text-muted"><i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard</a>
            </div>

            <div class="page-header">
                <h1 class="page-title">AI Descriptive Evaluation Review</h1>
                <p class="page-subtitle">Inspect rubric evaluations generated by the LLM for descriptive questions and optionally override marks.</p>
            </div>

            <% if (evaluations == null || evaluations.isEmpty()) { %>
                <div class="card p-5 text-center border-0 shadow-sm">
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fa-solid fa-signature text-muted"></i></div>
                        <h4 class="empty-title">No Descriptive Evaluations Found</h4>
                        <p class="empty-desc">When students submit descriptive answers, the AI criteria-based evaluation breakdown and suggested scores will be listed here.</p>
                    </div>
                </div>
            <% } else { %>
                <div class="d-flex flex-column gap-4">
                    <% for (DescriptiveEvaluation ev : evaluations) { %>
                        <div class="card border-0 shadow-sm p-4 bg-white">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                <div>
                                    <span class="badge badge-primary mb-1">Evaluation #<%= ev.getEvaluationId() %></span>
                                    <h4 class="fw-bold mb-1 text-navy"><%= ev.getQuestionText() %></h4>
                                    <div class="text-muted fs-sm">Student: <strong><%= ev.getStudentName() %></strong> | Attempt #<%= ev.getAttemptId() %></div>
                                </div>
                                <div class="text-end">
                                    <span class="fs-4 fw-bold <%= ev.isAdminOverridden() ? "text-warning" : "text-success" %>">
                                        <%= ev.getAwardedMarks() %> / <%= ev.getMaxMarks() %> Marks
                                    </span>
                                    <div class="fs-sm text-muted">
                                        <%= ev.isAdminOverridden() ? "Admin Overridden" : "AI Evaluated" %>
                                    </div>
                                </div>
                            </div>

                            <!-- Student's Submission -->
                            <div class="p-3 bg-light rounded mb-3">
                                <div class="text-muted fs-sm fw-bold mb-1">Student's Submitted Answer:</div>
                                <div style="white-space: pre-wrap;"><%= ev.getStudentAnswer() %></div>
                            </div>

                            <!-- AI Criteria Breakdown -->
                            <div class="row g-3 mb-3 fs-sm">
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-success-subtle">
                                        <div class="fw-bold text-success mb-1"><i class="fa-solid fa-circle-check me-1"></i> Concepts Identified:</div>
                                        <div style="white-space: pre-wrap;"><%= ev.getConceptsIdentified() %></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 border rounded bg-warning-subtle">
                                        <div class="fw-bold text-warning mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> Missing / Incomplete Concepts:</div>
                                        <div style="white-space: pre-wrap;"><%= ev.getMissingConcepts() %></div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-info fs-sm mb-3">
                                <strong>Feedback & Criteria:</strong> <%= ev.getCriterionFeedback() %>
                            </div>

                            <!-- Administrator Override Form -->
                            <form action="ai-evaluation-review" method="post" class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-3 border-top">
                                <input type="hidden" name="evaluationId" value="<%= ev.getEvaluationId() %>">

                                <div class="d-flex align-items-center gap-2">
                                    <label class="form-label mb-0 fs-sm text-nowrap fw-semibold">Override Marks:</label>
                                    <input type="number" name="newMarks" class="form-control form-control-sm"
                                           min="0" max="<%= ev.getMaxMarks() %>" value="<%= ev.getAwardedMarks() %>" style="width: 80px;" required>
                                    <input type="text" name="adminNotes" class="form-control form-control-sm"
                                           placeholder="Admin rationale / notes..." style="width: 250px;">
                                </div>

                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="fa-solid fa-check me-1"></i> Update Score
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>
            <% } %>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
